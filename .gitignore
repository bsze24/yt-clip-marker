.DS_Store
node_modules/
*.log
.env
__pycache__/
apps/studio/media/
# Derived channel listing, refreshed every 30 minutes by the Studio.
apps/studio/uploads.json
# Generated by `apps/studio/studio app`. It stays beside the script so its
# launcher can find the moved checkout relative to itself.
apps/studio/Clip Studio.app/

# Raw recording exports kept locally for reference — hundreds of MB each, not
# product. Matches any export folder under docs/reference/, not just the first
# one: a per-folder rule silently stops covering the next drop.
docs/reference/**/*.mp4
docs/reference/**/*.m4a
docs/reference/**/*.mkv
docs/reference/**/*.mov
# Raw meeting transcripts ship beside the media in a Zoom export. Small, but
# they are source exports rather than product, and leaving them untracked made
# every export folder show as `??` on a broad `git add` (F22). A deliberately
# curated parser fixture belongs somewhere else, tracked on purpose.
docs/reference/**/*.vtt
# Zoom's regenerated chat export is raw lesson input, not product state.
docs/reference/**/*newChat*.txt
.aider*
