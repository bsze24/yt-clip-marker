#!/usr/bin/env bash
# Start, stop and open the studio like an app.
#
# The server is a launchd agent so it survives a crash, a logout and anything
# that kills the process. `open` points a Chrome app window at it, which gives a
# dock icon and no URL bar — as close to a native app as a local web app gets.
#
#   apps/studio/studio install    write and load the launch agent (once)
#   apps/studio/studio app        build "Clip Studio.app" in ~/Applications
#   apps/studio/studio open       app window, starting the server if needed
#   apps/studio/studio start|stop|restart|status|logs|uninstall
#
# Restart after editing server.py. index.html and ui/* are read from disk on
# every request, so those only need a browser refresh.
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LABEL="com.briansze.yt-clip-studio"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/yt-clip-studio.log"
URL="http://studio.localhost:8765"
DOMAIN="gui/$(id -u)"

py() { command -v python3; }

write_plist() {
  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(py)</string>
    <string>$APP_DIR/server.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>$(dirname "$(dirname "$APP_DIR")")</string>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
PLIST
  plutil -lint "$PLIST" >/dev/null
}

up() { curl -fsS -o /dev/null --max-time 2 "$URL/" 2>/dev/null; }

# The plist and the app launcher both bake in an absolute path, resolved when
# they were generated. Move the clone and they point at a directory that is no
# longer there, and nothing rewrites them — `open` only bootstraps what exists.
# So check before using them, and regenerate rather than fail confusingly.
stale_plist() {
  [ -f "$PLIST" ] || return 1
  ! grep -q "<string>$APP_DIR/server.py</string>" "$PLIST"
}

heal_if_moved() {
  if stale_plist; then
    echo "the launch agent points at an old path — reinstalling from $APP_DIR" >&2
    "$0" install >/dev/null
  fi
}

wait_up() {
  for _ in $(seq 1 20); do up && return 0; sleep 0.3; done
  echo "server did not come up — check: $0 logs" >&2; return 1
}

case "${1:-open}" in
  install)
    write_plist
    # bootout is asynchronous. Bootstrapping straight after it fails with
    # "Bootstrap failed: 5: Input/output error" because the old service is still
    # being torn down, so wait for the label to actually disappear.
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    for _ in $(seq 1 20); do
      launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 || break
      sleep 0.3
    done
    launchctl bootstrap "$DOMAIN" "$PLIST"
    wait_up && echo "installed and running at $URL"
    ;;
  start)   launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null || launchctl kickstart "$DOMAIN/$LABEL"; wait_up && echo "$URL" ;;
  stop)    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true; echo "stopped" ;;
  restart) launchctl kickstart -k "$DOMAIN/$LABEL"; wait_up && echo "restarted" ;;
  status)
    if stale_plist; then echo "WARNING: launch agent points at an old path — run: $0 install"; fi
    if up; then echo "running   $URL"; else echo "not running"; fi
    launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/state = |pid = |last exit/ {print "  " $0}' || echo "  agent not loaded — run: $0 install"
    ;;
  logs)   tail -n "${2:-40}" "$LOG" ;;
  app)
    # A real double-clickable bundle, so this does not depend on a Chrome menu
    # path — those move between versions. It just runs `studio open`.
    BUNDLE="$HOME/Applications/Clip Studio.app"
    mkdir -p "$BUNDLE/Contents/MacOS"
    cat > "$BUNDLE/Contents/Info.plist" <<INFO
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Clip Studio</string>
  <key>CFBundleIdentifier</key><string>$LABEL.launcher</string>
  <key>CFBundleExecutable</key><string>launch</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
INFO
    printf '#!/bin/sh\nexec "%s" open\n' "$APP_DIR/studio" > "$BUNDLE/Contents/MacOS/launch"
    chmod +x "$BUNDLE/Contents/MacOS/launch"
    plutil -lint "$BUNDLE/Contents/Info.plist" >/dev/null
    echo "built $BUNDLE"
    echo "drag it to the Dock, or open it from Launchpad."
    ;;
  open)
    heal_if_moved
    # bootstrap if the agent was booted out (by the quit button, or by hand);
    # kickstart alone fails when the label is not loaded at all.
    up || {
      launchctl kickstart "$DOMAIN/$LABEL" 2>/dev/null \
        || launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null \
        || true
      wait_up
    }
    open -na "Google Chrome" --args --app="$URL" 2>/dev/null || open "$URL"
    ;;
  uninstall)
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"; echo "agent removed. the repo and your data are untouched."
    ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
